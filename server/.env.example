# All optional -- the server boots with no environment at all.

PORT=4000

# Leave blank to run entirely in memory (no database required).
# Set it to share the MX cache and disposable list across instances.
MONGO_URL=
MONGO_DB=inboxvalid

# '*' or a comma-separated allow-list of browser origins.
CORS_ORIGINS=*

# Fixed-window abuse control, per instance.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Cap on POST /v1/validate/batch
MAX_BATCH_SIZE=100

# DNS: short timeout, degrade to `unknown` rather than make the user wait.
DNS_TIMEOUT_MS=1500
DNS_SERVERS=

# MX cache
CACHE_MAX_ENTRIES=10000
CACHE_POSITIVE_TTL_SEC=86400
CACHE_NEGATIVE_TTL_SEC=300
